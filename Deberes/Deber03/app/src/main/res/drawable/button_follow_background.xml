<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado presionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gray"/> <!-- Color de fondo al presionar -->
            <corners android:radius="200dp"/> <!-- Radio de las esquinas -->
        </shape>
    </item>
    <!-- Estado normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gray"/> <!-- Color de fondo normal -->
            <corners android:radius="200dp"/> <!-- Radio de las esquinas -->
            <stroke android:width="1dp" android:color="@color/gray"/> <!-- Borde -->
        </shape>
    </item>
</selector>